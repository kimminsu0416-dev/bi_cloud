# ==========================================
# AI 뉴스 큐레이션 서비스 환경설정 (.env)
# ==========================================

# 1. Google Gemini API Key (무료 발급: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Naver Search OpenAPI (발급: https://developers.naver.com/apps/#/register)
#    - 사용 API: 검색 > 뉴스 검색
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 3. Django 기본 설정
DJANGO_SECRET_KEY=django-insecure-ai-news-curation-key-2026-vibe
DEBUG=True
ALLOWED_HOSTS=*

# 4. 클라우드 영구 무료 PostgreSQL 데이터베이스 (Supabase, Neon 등 - 선택사항)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

